# Copy to .streamlit/secrets.toml for local runs (never commit that file),
# or paste these three lines into "Advanced settings > Secrets" on Streamlit
# Community Cloud. Leave them out entirely to run with AI off.

LLM_API_KEY = "paste-your-key-here"
LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
LLM_MODEL = "name-of-a-current-model-from-your-provider"

# Optional. Only for models that accept it.
# LLM_REASONING_EFFORT = "low"
